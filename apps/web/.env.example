# Cardano Network: 0 for Preview Testnet, 1 for Mainnet
NEXT_PUBLIC_CARDANO_NETWORK_ID=0

# Blockfrost Project API Key (Cardano Preview)
# Get your free key at https://blockfrost.io
NEXT_PUBLIC_BLOCKFROST_API_KEY=your_blockfrost_preview_api_key

# Pinata IPFS Credentials for Meal Proof Uploads
# Get your keys at https://www.pinata.cloud
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key
NEXT_PUBLIC_PINATA_SECRET_KEY=your_pinata_secret_key
# Or Pinata JWT Token
# NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_token
